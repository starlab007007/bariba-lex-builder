{
  "id": "outro_sub",
  "name": "Outro Secondaire",
  "description": "Sous-titre de fin avec fade simple",
  "version": "1.0.0",
  
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "size": 22,
    "weight": 400,
    "style": "normal",
    "letterSpacing": 0.5
  },
  
  "colors": {
    "fill": "rgba(255,255,255,0.85)",
    "stroke": "transparent"
  },
  
  "shadow": {
    "offsetX": 0,
    "offsetY": 2,
    "blur": 6,
    "color": "rgba(0,0,0,0.3)"
  },
  
  "glow": {
    "enabled": false
  },
  
  "animation": {
    "entrance": "fade_in",
    "entranceDuration": 0.4,
    "easing": "ease-out"
  }
}
