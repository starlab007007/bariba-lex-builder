{
  "id": "calligraphy_sub",
  "name": "Calligraphie Secondaire",
  "description": "Sous-calligraphie avec animation brush reveal",
  "version": "1.0.0",
  
  "font": {
    "family": "'Ma Shan Zheng', 'Noto Serif SC', 'SimSun', serif",
    "size": 56,
    "weight": 400,
    "style": "normal"
  },
  
  "colors": {
    "fill": "#8B0000",
    "stroke": "transparent"
  },
  
  "shadow": {
    "offsetX": 2,
    "offsetY": 2,
    "blur": 4,
    "color": "rgba(0,0,0,0.25)"
  },
  
  "glow": {
    "enabled": false
  },
  
  "animation": {
    "entrance": "brush_reveal",
    "entranceDuration": 0.6,
    "delay": 0.4,
    "easing": "ease-out",
    "brushDirection": "left_to_right"
  }
}
