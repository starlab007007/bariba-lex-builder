{
  "id": "template_label",
  "name": "Label Template",
  "description": "Badge de template dans le coin avec glow doré",
  "version": "1.0.0",
  
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "size": 16,
    "weight": 600,
    "style": "normal"
  },
  
  "colors": {
    "fill": "#FFFFFF",
    "stroke": "transparent"
  },
  
  "shadow": {
    "offsetX": 0,
    "offsetY": 2,
    "blur": 8,
    "color": "rgba(0,0,0,0.4)"
  },
  
  "glow": {
    "enabled": true,
    "color": "rgba(255,215,0,0.7)",
    "blur": 12,
    "pulse": {
      "enabled": true,
      "minOpacity": 0.5,
      "maxOpacity": 0.9,
      "duration": 0.8
    }
  },
  
  "animation": {
    "entrance": "elastic_bounce",
    "entranceDuration": 0.5,
    "easing": "cubic-bezier(0.68,-0.55,0.265,1.55)"
  },
  
  "badge": {
    "enabled": true,
    "padding": { "x": 12, "y": 6 },
    "borderRadius": 8,
    "background": "rgba(0,0,0,0.7)",
    "border": {
      "width": 1,
      "color": "rgba(255,215,0,0.4)"
    }
  }
}
