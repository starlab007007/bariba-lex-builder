{
  "id": "outro_main",
  "name": "Outro Principal",
  "description": "Badge de fin avec gradient premium et zoom blur",
  "version": "1.0.0",
  
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "size": 42,
    "weight": 700,
    "style": "normal",
    "letterSpacing": 1
  },
  
  "colors": {
    "fill": {
      "type": "gradient",
      "gradient": {
        "type": "linear",
        "angle": 135,
        "stops": [
          { "offset": 0, "color": "#0066FF" },
          { "offset": 0.5, "color": "#00D4FF" },
          { "offset": 1, "color": "#FFD700" }
        ]
      }
    },
    "stroke": "rgba(255,255,255,0.8)"
  },
  
  "stroke": {
    "width": 2,
    "join": "round"
  },
  
  "shadow": {
    "offsetX": 0,
    "offsetY": 4,
    "blur": 20,
    "color": "rgba(0,102,255,0.5)"
  },
  
  "glow": {
    "enabled": true,
    "color": "rgba(0,212,255,0.6)",
    "blur": 30,
    "pulse": {
      "enabled": true,
      "minOpacity": 0.5,
      "maxOpacity": 0.9,
      "duration": 0.6
    }
  },
  
  "animation": {
    "entrance": "zoom_blur_in",
    "entranceDuration": 0.6,
    "easing": "cubic-bezier(0.25,0.46,0.45,0.94)"
  },
  
  "badge": {
    "enabled": true,
    "padding": { "x": 24, "y": 12 },
    "borderRadius": 12,
    "background": "rgba(0,0,0,0.6)",
    "border": {
      "width": 1,
      "color": "rgba(255,255,255,0.2)"
    }
  }
}
