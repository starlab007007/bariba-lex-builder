{
  "id": "calligraphy_main",
  "name": "Calligraphie Principale",
  "description": "Style calligraphique chinois avec effet pinceau et encre",
  "version": "1.0.0",
  
  "font": {
    "family": "'Ma Shan Zheng', 'Noto Serif SC', 'SimSun', serif",
    "size": 96,
    "weight": 400,
    "style": "normal"
  },
  
  "colors": {
    "fill": "#1A1A1A",
    "stroke": "transparent"
  },
  
  "shadow": {
    "offsetX": 3,
    "offsetY": 3,
    "blur": 6,
    "color": "rgba(0,0,0,0.3)"
  },
  
  "glow": {
    "enabled": true,
    "color": "rgba(255,215,0,0.4)",
    "blur": 25,
    "pulse": {
      "enabled": true,
      "minOpacity": 0.3,
      "maxOpacity": 0.6,
      "duration": 1.2
    }
  },
  
  "inkSplash": {
    "enabled": true,
    "count": 5,
    "sizeRange": [8, 25],
    "opacity": 0.15,
    "animation": "splash_in"
  },
  
  "animation": {
    "entrance": "brush_reveal",
    "entranceDuration": 0.8,
    "easing": "ease-out",
    "brushDirection": "left_to_right"
  },
  
  "background": {
    "enabled": true,
    "type": "paper_texture",
    "opacity": 0.08,
    "blend": "multiply"
  }
}
