{
  "id": "message_sub",
  "name": "Sous-Message",
  "description": "Texte secondaire élégant avec fade subtil",
  "version": "1.0.0",
  
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "size": 28,
    "weight": 500,
    "style": "normal",
    "letterSpacing": 1.5
  },
  
  "colors": {
    "fill": "rgba(255,255,255,0.95)",
    "stroke": "transparent"
  },
  
  "shadow": {
    "offsetX": 1,
    "offsetY": 1,
    "blur": 8,
    "color": "rgba(0,0,0,0.4)"
  },
  
  "glow": {
    "enabled": false
  },
  
  "animation": {
    "entrance": "fade_up",
    "entranceDuration": 0.5,
    "easing": "ease-out"
  }
}
