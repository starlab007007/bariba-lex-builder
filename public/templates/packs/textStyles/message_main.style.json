{
  "id": "message_main",
  "name": "Message Principal",
  "description": "Texte principal avec gradient doré et glow",
  "version": "1.0.0",
  
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "size": 64,
    "weight": 800,
    "style": "normal",
    "letterSpacing": 2
  },
  
  "colors": {
    "fill": {
      "type": "gradient",
      "gradient": {
        "type": "linear",
        "angle": 135,
        "stops": [
          { "offset": 0, "color": "#FFD700" },
          { "offset": 0.5, "color": "#FFA500" },
          { "offset": 1, "color": "#FF6347" }
        ]
      }
    },
    "stroke": "rgba(255,255,255,0.9)"
  },
  
  "stroke": {
    "width": 3,
    "join": "round"
  },
  
  "shadow": {
    "offsetX": 2,
    "offsetY": 2,
    "blur": 10,
    "color": "rgba(0,0,0,0.5)"
  },
  
  "glow": {
    "enabled": true,
    "color": "rgba(255,215,0,0.5)",
    "blur": 20,
    "pulse": {
      "enabled": true,
      "minOpacity": 0.4,
      "maxOpacity": 0.7,
      "duration": 0.8
    }
  },
  
  "animation": {
    "entrance": "elastic_bounce",
    "entranceDuration": 0.7,
    "easing": "cubic-bezier(0.68,-0.55,0.265,1.55)",
    "beatSync": true
  },
  
  "beatSync": {
    "property": "glow",
    "range": [0.5, 1.0],
    "intensity": 0.8
  }
}
