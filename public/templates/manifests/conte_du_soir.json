{
  "id": "conte_du_soir",
  "name": "Conte du Soir",
  "description": "Conte pour enfants avec ambiance magique",
  "version": "1.0.0",
  "duration": 90,
  "ratio": "9:16",
  "category": "storytelling",
  "family": "educatif_culture",
  "tags": ["story", "children", "magic", "tradition"],

  "slots": [
    {
      "id": "photo_illustration",
      "description": "Image d'illustration",
      "type": "photo",
      "required": true,
      "min": 1,
      "max": 1
    },
    {
      "id": "audio_story",
      "description": "Le conte raconté",
      "type": "audio",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 30,
        "maxDurationSec": 180
      }
    }
  ],

  "pipeline": [
    { "op": "narrative_structure", "params": { "pattern": "story_arc" }, "output": "chapters", "weight": 0.20 },
    { "op": "photo_animation", "params": { "mode": "gentle_zoom" }, "output": "animatedPhotos", "weight": 0.25 },
    { "op": "audio_enhance", "params": { "denoise": true, "warmth": 0.2 }, "output": "audioFx", "weight": 0.25 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"] }, "output": "subtitleTrack", "weight": 0.20 }
  ],

  "timeline": [
    {
      "id": "bg_layer",
      "type": "video_layer",
      "zIndex": 0,
      "start": 0,
      "end": 90,
      "asset": "scenes/fireplace_bg.mp4",
      "blend": "normal"
    },
    {
      "id": "photo_layer",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 90,
      "slotRef": "photo_illustration",
      "blend": "normal",
      "effects": ["filter_warm_soft"]
    },
    {
      "id": "moon_overlay",
      "type": "sticker_layer",
      "zIndex": 5,
      "start": 0,
      "end": 90,
      "asset": "overlays/moon_glow.png",
      "blend": "screen"
    },
    {
      "id": "title_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 2,
      "end": 8,
      "text": "🌙 Conte du Soir",
      "style": "cinema_subtitles",
      "animation": { "type": "fade", "duration": 1, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover"],

  "music": {
    "enabled": true,
    "beatSync": false,
    "defaultTrack": "fireplace_ambiance"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#Conte", "#Enfants", "#Tradition"]
  },

  "cardHint": {
    "inputSummary": "1 Photo + 1 Audio",
    "timeLabel": "01:30"
  },

  "export": {
    "fps": 24,
    "preset": "medium",
    "crf": 20
  }
}
