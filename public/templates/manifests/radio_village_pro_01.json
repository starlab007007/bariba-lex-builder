  "segments": [
    {
      "id": "main_audio_visual",
      "type": "audio_visualizer",
      "start": 0,
      "duration": "audio_duration",
      "editable": false,
      "layers": [
        {
          "id": "background_layer",
          "type": "photo_background",
          "source": "photo_village || photo_context || default_village",
          "zIndex": 1,
          "effects": {
            "blur": { "enabled": true, "amount": 15, "algorithm": "gaussian" },
            "brightness": { "enabled": true, "amount": -0.3 },
            "parallax": { "enabled": true, "speed": "slow", "direction": "vertical", "amplitude": 20 },
            "zoom": { "enabled": true, "from": 1.0, "to": 1.05, "duration": "full", "easing": "linear" }
