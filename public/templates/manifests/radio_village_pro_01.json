              "gradient": { "type": "radial", "colors": [{ "offset": 0, "color": "style_primary" }, { "offset": 1, "color": "style_secondary" }] },
              "strokeWidth": 4,
              "glowEnabled": true,
              "glowColor": "style_primary",
              "glowBlur": 20
