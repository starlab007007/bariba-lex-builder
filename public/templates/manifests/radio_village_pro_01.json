        },
        {
          "id": "waveform_layer",
          "type": "audio_waveform",
          "zIndex": 2,
          "config": {
            "style": "circular",
            "position": { "x": 0.5, "y": 0.5 },
            "size": { "width": "40%", "height": "40%" },
