              }
            },
            "animation": { "type": "word_by_word", "highlightColor": "style_primary", "highlightDuration": 200, "fadeInDuration": 150, "fadeOutDuration": 150 }
          }
        },
        {
          "id": "emoji_reactions_layer",
          "type": "emoji_reactions",
          "zIndex": 5,
          "config": {
            "enabled": true,
            "trigger": "keyword_detection",
