{
  "id": "karaoke_mode",
  "name": "Mode Karaoké",
  "description": "Sous-titres synchronisés mot par mot",
  "version": "1.0.0",
  "duration": 60,
  "ratio": "9:16",
  "category": "vocal",
  "family": "vocal_radio",
  "tags": ["karaoke", "lyrics", "singing", "music"],
  "slots": [{ "id": "audio_song", "description": "Chanson ou poème", "type": "audio", "required": true, "min": 1, "max": 1, "constraints": { "minDurationSec": 10, "maxDurationSec": 120 } }],
  "pipeline": [
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"], "mode": "word_by_word" }, "output": "karaokeTrack", "weight": 0.45 },
    { "op": "audio_enhance", "params": { "denoise": true }, "output": "audioFx", "weight": 0.25 }
  ],
  "timeline": [
    { "id": "karaoke_bg", "type": "video_layer", "zIndex": 0, "start": 0, "end": 60, "asset": "scenes/karaoke_bg.mp4", "blend": "normal" },
    { "id": "lyrics_layer", "type": "text_layer", "zIndex": 10, "start": 0, "end": 60, "text": "{{karaokeTrack}}", "style": "karaoke_highlight" }
  ],
  "overrides": ["text", "cover", "enhance"],
  "music": { "enabled": false },
  "publishDefaults": { "allowDuo": true, "hashtags": ["#Karaoké", "#Chant", "#Musique"] },
  "cardHint": { "inputSummary": "1 Audio", "timeLabel": "01:00" },
  "export": { "fps": 30, "preset": "medium", "crf": 21 }
}
