{
  "id": "multi_format_export",
  "name": "Multi-Format",
  "description": "Export 3 formats auto (9:16, 1:1, 16:9)",
  "version": "1.0.0",
  "duration": 30,
  "ratio": "9:16",
  "category": "transition",
  "family": "grand_public",
  "tags": ["multi-format", "export", "social", "professional"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo source",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 10,
        "maxDurationSec": 60
      }
    }
  ],

  "pipeline": [
    { "op": "smart_crop", "params": { "target": "person", "mode": "reframe" }, "output": "cropRect", "weight": 0.25 },
    { "op": "auto_editing", "params": { "cuts": "auto" }, "output": "editPlan", "weight": 0.20 },
    { "op": "multi_format_export_plan", "params": { "ratios": ["9:16", "1:1", "16:9"] }, "output": "exportPlan", "weight": 0.30 },
    { "op": "denoise_sharpen", "params": { "level": 0.3 }, "output": "enhanced", "weight": 0.15 }
  ],

  "timeline": [
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 30,
      "slotRef": "video_main",
      "blend": "normal"
    },
    {
      "id": "format_badge",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0.5,
      "end": 4,
      "text": "📐 3 Formats",
      "style": "bold_hook",
      "animation": { "type": "slide", "duration": 0.4, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "cover", "enhance"],

  "music": {
    "enabled": false,
    "beatSync": false
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#MultiFormat", "#Social", "#Pro"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:30"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 20
  }
}
