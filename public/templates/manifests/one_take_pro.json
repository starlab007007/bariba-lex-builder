{
  "id": "one_take_pro",
  "name": "One-Take Pro 🐴",
  "description": "Template premium 15s avec effets Kuaishou Horse - Sparkles, Calligraphie, Beat Sync",
  "version": "2.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "transition",
  "family": "grand_public",
  "tags": ["kuaishou", "horse", "sparkles", "calligraphy", "beat-sync", "premium", "2026"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo principale (Ken Burns effect)",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 5,
        "maxDurationSec": 60
      }
    }
  ],

  "pipeline": [
    { "op": "stabilization", "params": { "strength": 0.9, "smoothing": "ultra" }, "output": "stabilizedVideo", "weight": 0.25 },
    { "op": "smart_crop", "params": { "target": "person", "mode": "ken_burns", "zoom": 1.12 }, "output": "cropRect", "weight": 0.15 },
    { "op": "beat_detect", "params": { "bpm": 128, "sensitivity": 0.8 }, "output": "beatMap", "weight": 0.20 },
    { "op": "color_grade", "params": { "preset": "warm_glow", "intensity": 0.7 }, "output": "graded", "weight": 0.15 },
    { "op": "sparkle_gen", "params": { "count": 16, "size": "medium" }, "output": "sparkles", "weight": 0.15 },
    { "op": "denoise_sharpen", "params": { "level": 0.4 }, "output": "enhanced", "weight": 0.10 }
  ],

  "phases": {
    "intro": { "start": 0, "end": 1.6, "label": "Intro Flash" },
    "main": { "start": 1.6, "end": 12.8, "label": "Main Content" },
    "outro": { "start": 12.8, "end": 15, "label": "Outro Fade" }
  },

  "effects": {
    "warm_glow": {
      "enabled": true,
      "gradient": {
        "type": "radial",
        "colors": ["rgba(255,200,100,0.25)", "transparent"],
        "center": { "x": 0.5, "y": 0.3 }
      }
    },
    "vignette_cinematic": {
      "enabled": true,
      "intensity": 0.6,
      "color": "rgba(0,0,0,0.7)"
    },
    "beat_glow": {
      "enabled": true,
      "color": "rgba(255,215,0,0.3)",
      "pulseRange": [0.8, 1.2],
      "syncToBeat": true
    },
    "sparkles": {
      "enabled": true,
      "count": 16,
      "colors": ["#FFD700", "#FFA500", "#FF6347", "#FFFFFF"],
      "sizeRange": [3, 8],
      "twinkleSpeed": 0.5
    },
    "calligraphy_badge": {
      "enabled": true,
      "font": "Ma Shan Zheng",
      "inkSplash": true,
      "glowColor": "#FFD700"
    },
    "horse_silhouette": {
      "enabled": true,
      "svg": "/templates/assets/horse_silhouette.svg",
      "animation": "gallop_across",
      "color": "#FFD700"
    },
    "progress_bar": {
      "enabled": true,
      "position": "bottom",
      "height": 4,
      "color": "#FFD700",
      "glowColor": "rgba(255,215,0,0.5)"
    }
  },

  "timeline": [
    {
      "id": "background_layer",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 15,
      "slotRef": "video_main",
      "blend": "normal",
      "effects": ["ken_burns", "color_grade", "warm_glow"],
      "kenBurns": {
        "startZoom": 1.0,
        "endZoom": 1.12,
        "panX": [-0.05, 0.05],
        "panY": [-0.02, 0.02]
      }
    },
    {
      "id": "warm_glow_overlay",
      "type": "effect_layer",
      "zIndex": 2,
      "start": 0,
      "end": 15,
      "effect": "warm_glow",
      "animation": { "type": "breathe", "duration": 2.0, "intensity": [0.8, 1.2] }
    },
    {
      "id": "vignette_layer",
      "type": "effect_layer",
      "zIndex": 3,
      "start": 0,
      "end": 15,
      "effect": "vignette_cinematic"
    },
    {
      "id": "beat_glow_layer",
      "type": "effect_layer",
      "zIndex": 4,
      "start": 0,
      "end": 15,
      "effect": "beat_glow",
      "syncSource": "beatMap"
    },
    {
      "id": "sparkle_field",
      "type": "particle_layer",
      "zIndex": 5,
      "start": 0,
      "end": 15,
      "particles": {
        "type": "sparkle",
        "count": 16,
        "distribution": "scattered",
        "colors": ["#FFD700", "#FFA500", "#FF6347", "#FFFFFF"],
        "animation": "twinkle_float"
      }
    },
    {
      "id": "year_hero_2026",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0.2,
      "end": 2.5,
      "text": "2026",
      "style": "year_hero",
      "position": { "x": 0.5, "y": 0.5 },
      "animation": { 
        "type": "scale_fade_in", 
        "duration": 0.6, 
        "easing": "cubic-bezier(0.34,1.56,0.64,1)",
        "beatSync": true
      }
    },
    {
      "id": "calligraphy_main",
      "type": "text_layer",
      "zIndex": 11,
      "start": 0.8,
      "end": 3.5,
      "text": "蛇年大吉",
      "style": "calligraphy_main",
      "position": { "x": 0.5, "y": 0.35 },
      "animation": { 
        "type": "brush_reveal", 
        "duration": 0.8, 
        "inkSplash": true,
        "glowPulse": true
      }
    },
    {
      "id": "calligraphy_sub",
      "type": "text_layer",
      "zIndex": 11,
      "start": 1.2,
      "end": 3.5,
      "text": "福满乾坤",
      "style": "calligraphy_sub",
      "position": { "x": 0.5, "y": 0.65 },
      "animation": { 
        "type": "brush_reveal", 
        "duration": 0.6, 
        "delay": 0.4
      }
    },
    {
      "id": "message_main",
      "type": "text_layer",
      "zIndex": 12,
      "start": 4,
      "end": 9,
      "text": "✨ TAM-TAM",
      "style": "message_main",
      "position": { "x": 0.5, "y": 0.25 },
      "animation": { 
        "type": "elastic_bounce", 
        "duration": 0.7,
        "beatSync": true
      }
    },
    {
      "id": "message_sub",
      "type": "text_layer",
      "zIndex": 12,
      "start": 4.5,
      "end": 9,
      "text": "Créez. Partagez. Inspirez.",
      "style": "message_sub",
      "position": { "x": 0.5, "y": 0.75 },
      "animation": { "type": "fade_up", "duration": 0.5 }
    },
    {
      "id": "horse_silhouette",
      "type": "graphic_layer",
      "zIndex": 8,
      "start": 5,
      "end": 10,
      "graphic": "horse_silhouette",
      "color": "#FFD700",
      "animation": {
        "type": "gallop_across",
        "duration": 5,
        "path": "left_to_right",
        "easing": "ease-in-out",
        "shadow": {
          "enabled": true,
          "blur": 15,
          "color": "rgba(255,215,0,0.5)"
        }
      }
    },
    {
      "id": "outro_main",
      "type": "text_layer",
      "zIndex": 13,
      "start": 12.8,
      "end": 15,
      "text": "🎬 One-Take Pro",
      "style": "outro_main",
      "position": { "x": 0.5, "y": 0.4 },
      "animation": { 
        "type": "zoom_blur_in", 
        "duration": 0.6,
        "gradient": {
          "type": "linear",
          "angle": 135,
          "colors": ["#0066FF", "#00D4FF", "#FFD700"]
        }
      }
    },
    {
      "id": "outro_sub",
      "type": "text_layer",
      "zIndex": 13,
      "start": 13.2,
      "end": 15,
      "text": "Powered by TAM-TAM 🐴",
      "style": "outro_sub",
      "position": { "x": 0.5, "y": 0.6 },
      "animation": { "type": "fade_in", "duration": 0.4 }
    },
    {
      "id": "progress_bar",
      "type": "ui_layer",
      "zIndex": 20,
      "start": 0,
      "end": 15,
      "element": "progress_bar",
      "position": { "x": 0, "y": 0.98 },
      "size": { "width": 1, "height": 0.004 },
      "style": {
        "backgroundColor": "rgba(255,255,255,0.2)",
        "fillColor": "#FFD700",
        "glow": "rgba(255,215,0,0.6)"
      }
    },
    {
      "id": "template_label",
      "type": "text_layer",
      "zIndex": 15,
      "start": 0,
      "end": 3,
      "text": "🐴 One-Take Pro",
      "style": "template_label",
      "position": { "x": 0.12, "y": 0.92 },
      "animation": { 
        "type": "elastic_bounce", 
        "duration": 0.5,
        "glow": {
          "enabled": true,
          "color": "#FFD700",
          "blur": 12,
          "pulse": true
        }
      }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover", "enhance", "speed"],

  "music": {
    "enabled": true,
    "beatSync": true,
    "bpm": 128,
    "defaultTrack": "/audio/kuaishou_festive_beat.mp3"
  },

  "audio": {
    "volumeCurve": [
      { "time": 0, "volume": 0 },
      { "time": 0.3, "volume": 1 },
      { "time": 14, "volume": 1 },
      { "time": 15, "volume": 0 }
    ]
  },

  "publishDefaults": {
    "allowDuo": true,
    "hashtags": ["#OneTakePro", "#TAM-TAM", "#2026", "#HorseYear", "#Premium"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:15",
    "features": ["Beat Sync", "Ken Burns", "Sparkles", "Horse"]
  },

  "export": {
    "fps": 30,
    "preset": "high",
    "crf": 18,
    "codec": "libx264"
  }
}
