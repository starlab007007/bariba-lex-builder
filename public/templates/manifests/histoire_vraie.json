{
  "id": "histoire_vraie",
  "name": "Histoire Vraie",
  "description": "Problème → Solution en storytelling",
  "version": "1.0.0",
  "duration": 60,
  "ratio": "9:16",
  "category": "storytelling",
  "family": "educatif_culture",
  "tags": ["story", "real", "narrative", "solution"],

  "slots": [
    {
      "id": "audio_story",
      "description": "Ton histoire (10-30s)",
      "type": "audio",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 10,
        "maxDurationSec": 30
      }
    },
    {
      "id": "photos",
      "description": "Photos illustration (1-3)",
      "type": "photo",
      "required": true,
      "min": 1,
      "max": 3
    }
  ],

  "pipeline": [
    { "op": "narrative_structure", "params": { "pattern": "problem_action_solution" }, "output": "chapters", "weight": 0.25 },
    { "op": "photo_animation", "params": { "mode": "kenburns+depth" }, "output": "animatedPhotos", "weight": 0.25 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"] }, "output": "subtitleTrack", "weight": 0.25 },
    { "op": "audio_enhance", "params": { "denoise": true }, "output": "audioFx", "weight": 0.15 }
  ],

  "timeline": [
    {
      "id": "bg_layer",
      "type": "video_layer",
      "zIndex": 0,
      "start": 0,
      "end": 60,
      "asset": "scenes/story_bg.mp4",
      "blend": "normal"
    },
    {
      "id": "photos_layer",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 60,
      "slotRef": "photos",
      "blend": "normal"
    },
    {
      "id": "problem_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 2,
      "end": 20,
      "text": "📖 Le problème...",
      "style": "cinema_subtitles",
      "animation": { "type": "fade", "duration": 0.5, "easing": "ease-out" }
    },
    {
      "id": "solution_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 40,
      "end": 58,
      "text": "✅ La solution",
      "style": "cinema_subtitles",
      "animation": { "type": "fade", "duration": 0.5, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover"],

  "music": {
    "enabled": true,
    "beatSync": false,
    "defaultTrack": "emotional_piano"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#HistoireVraie", "#Témoignage", "#Solution"]
  },

  "cardHint": {
    "inputSummary": "1 Audio + 1-3 Photos",
    "timeLabel": "01:00"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 20
  }
}
