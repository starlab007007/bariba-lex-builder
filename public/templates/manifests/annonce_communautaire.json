{
  "id": "annonce_communautaire",
  "name": "Annonce Communauté",
  "description": "Message + pictos pour marché, cérémonie, alerte",
  "version": "1.0.0",
  "duration": 30,
  "ratio": "9:16",
  "category": "vocal",
  "family": "vocal_radio",
  "tags": ["announcement", "community", "alert", "market"],
  "slots": [{ "id": "audio_main", "description": "Annonce vocale", "type": "audio", "required": true, "min": 1, "max": 1 }],
  "pipeline": [
    { "op": "audio_enhance", "params": { "denoise": true, "amplify": true }, "output": "audioFx", "weight": 0.35 },
    { "op": "icon_injection", "params": { "mode": "announcement_icons" }, "output": "iconLayer", "weight": 0.35 }
  ],
  "timeline": [
    { "id": "bg_layer", "type": "video_layer", "zIndex": 0, "start": 0, "end": 30, "asset": "scenes/announcement_bg.mp4", "blend": "normal" },
    { "id": "megaphone", "type": "sticker_layer", "zIndex": 5, "start": 0, "end": 30, "asset": "overlays/megaphone.png", "blend": "normal" }
  ],
  "overrides": ["text", "cover"],
  "music": { "enabled": false },
  "publishDefaults": { "allowDuo": false, "hashtags": ["#Annonce", "#Communauté"] },
  "cardHint": { "inputSummary": "1 Audio", "timeLabel": "00:30" },
  "export": { "fps": 30, "preset": "fast", "crf": 22 }
}
