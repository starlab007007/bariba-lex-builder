{
  "id": "photo_slideshow",
  "name": "Diaporama Photo",
  "description": "Diaporama animé avec transitions et musique",
  "version": "1.0.0",
  "duration": 30,
  "ratio": "9:16",
  "category": "transition",
  "family": "grand_public",
  "tags": ["slideshow", "photos", "memories", "music"],
  "slots": [{ "id": "photos", "description": "3 à 10 photos", "type": "photo", "required": true, "min": 3, "max": 10 }],
  "pipeline": [
    { "op": "photo_animation", "params": { "mode": "kenburns+transitions" }, "output": "animatedPhotos", "weight": 0.45 },
    { "op": "beat_detect", "params": { "sensitivity": 0.6 }, "output": "beatMap", "weight": 0.25 }
  ],
  "timeline": [
    { "id": "photos_layer", "type": "user_media_layer", "zIndex": 1, "start": 0, "end": 30, "slotRef": "photos", "blend": "normal" }
  ],
  "overrides": ["music", "text", "cover"],
  "music": { "enabled": true, "beatSync": true, "defaultTrack": "uplifting_pop" },
  "publishDefaults": { "allowDuo": false, "hashtags": ["#Diaporama", "#Souvenirs", "#Photos"] },
  "cardHint": { "inputSummary": "3-10 Photos", "timeLabel": "00:30" },
  "export": { "fps": 30, "preset": "medium", "crf": 21 }
}
