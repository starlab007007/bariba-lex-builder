{
  "id": "auto_broll_booster",
  "name": "B-Roll Booster",
  "description": "Ajout automatique de plans de coupe",
  "version": "1.0.0",
  "duration": 60,
  "ratio": "9:16",
  "category": "storytelling",
  "family": "grand_public",
  "tags": ["broll", "professional", "editing", "documentary"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo principale",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 30,
        "maxDurationSec": 120
      }
    }
  ],

  "pipeline": [
    { "op": "broll_insertion", "params": { "source": "stock_or_user", "intensity": 0.35 }, "output": "brollPlan", "weight": 0.40 },
    { "op": "auto_editing", "params": { "cuts": "contextual", "pacing": "documentary" }, "output": "editPlan", "weight": 0.25 },
    { "op": "audio_enhance", "params": { "denoise": true }, "output": "audioFx", "weight": 0.15 },
    { "op": "denoise_sharpen", "params": { "level": 0.3 }, "output": "enhanced", "weight": 0.10 }
  ],

  "timeline": [
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 60,
      "slotRef": "video_main",
      "blend": "normal"
    },
    {
      "id": "broll_layer",
      "type": "video_layer",
      "zIndex": 2,
      "start": 0,
      "end": 60,
      "track": "brollPlan",
      "blend": "normal"
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover", "enhance"],

  "music": {
    "enabled": true,
    "beatSync": false,
    "defaultTrack": "documentary_ambient"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#BRoll", "#Pro", "#Documentary"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "01:00"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 20
  }
}
