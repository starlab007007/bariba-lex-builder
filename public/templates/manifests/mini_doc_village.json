{
  "id": "mini_doc_village",
  "name": "Mini-Doc Village",
  "description": "Mini documentaire avec narration IA et sous-titres bilingues (Français/Bariba)",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "documentary",
  "family": "educatif_culture",
  "collection": "patrimoine_vivant",
  "tags": ["documentary", "village", "culture", "patrimoine", "bariba"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo du village (min 10s)",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 10,
        "maxDurationSec": 60
      }
    }
  ],

  "pipeline": [
    { "op": "smart_crop", "params": { "target": "person", "mode": "reframe" }, "output": "cropRect", "weight": 0.10 },
    { "op": "stabilization", "params": { "strength": 0.7 }, "output": "stabilized", "weight": 0.15 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"], "align": "forced" }, "output": "subtitleTrack", "weight": 0.25 },
    { "op": "translation_subtitles", "params": { "targetLangs": ["fr", "ba"] }, "output": "translatedTracks", "weight": 0.15 },
    { "op": "style_transfer", "params": { "preset": "documentary" }, "output": "styledVideo", "weight": 0.15 },
    { "op": "audio_enhance", "params": { "denoise": true, "normalize": true }, "output": "audioFx", "weight": 0.10 },
    { "op": "denoise_sharpen", "params": { "level": 0.30 }, "output": "enhanced", "weight": 0.10 }
  ],

  "timeline": [
    {
      "id": "bg_layer",
      "type": "video_layer",
      "zIndex": 0,
      "start": 0,
      "end": 15,
      "asset": "scenes/village_bg.mp4",
      "blend": "normal"
    },
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 15,
      "slotRef": "video_main",
      "blend": "normal",
      "effects": ["filter_documentary", "vignette_soft"]
    },
    {
      "id": "subtitles_layer",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0,
      "end": 15,
      "text": "{{subtitleTrack}}",
      "style": "documentary_white"
    },
    {
      "id": "intro_overlay",
      "type": "overlay_layer",
      "zIndex": 5,
      "start": 0,
      "end": 2,
      "asset": "overlays/title_intro.png",
      "blend": "screen",
      "animation": { "type": "fade", "duration": 0.5, "easing": "ease-out" }
    },
    {
      "id": "badge_overlay",
      "type": "overlay_layer",
      "zIndex": 5,
      "start": 0,
      "end": 15,
      "asset": "overlays/mini_doc_badge.png",
      "blend": "screen",
      "transform": { "x": 0.05, "y": 0.92, "scale": 0.8, "rotation": 0, "opacity": 0.9 }
    },
    {
      "id": "outro_overlay",
      "type": "overlay_layer",
      "zIndex": 5,
      "start": 13,
      "end": 15,
      "asset": "overlays/outro_badge.png",
      "blend": "screen",
      "animation": { "type": "fade", "duration": 0.4, "easing": "ease-in" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover", "enhance"],

  "music": {
    "enabled": true,
    "beatSync": false,
    "defaultTrack": "traditional_soft"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#MiniDoc", "#Village", "#Patrimoine", "#Bariba"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:15"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 18
  }
}
