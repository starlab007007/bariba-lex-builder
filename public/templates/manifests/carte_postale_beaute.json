{
  "id": "carte_postale_beaute",
  "name": "Carte Postale",
  "description": "Paysage sublimé - montre la beauté",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "storytelling",
  "family": "educatif_culture",
  "tags": ["landscape", "beauty", "postcard", "nature"],

  "slots": [
    {
      "id": "photo_landscape",
      "description": "Photo de paysage",
      "type": "photo",
      "required": true,
      "min": 1,
      "max": 1
    }
  ],

  "pipeline": [
    { "op": "style_transfer", "params": { "preset": "golden_hour" }, "output": "styledPhoto", "weight": 0.35 },
    { "op": "photo_animation", "params": { "mode": "kenburns+parallax" }, "output": "animatedPhoto", "weight": 0.40 },
    { "op": "denoise_sharpen", "params": { "level": 0.4 }, "output": "enhanced", "weight": 0.15 }
  ],

  "timeline": [
    {
      "id": "photo_layer",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 15,
      "slotRef": "photo_landscape",
      "blend": "normal",
      "effects": ["filter_golden_hour"]
    },
    {
      "id": "sun_flare",
      "type": "sticker_layer",
      "zIndex": 5,
      "start": 0,
      "end": 15,
      "asset": "overlays/sun_flare.png",
      "blend": "screen"
    },
    {
      "id": "postcard_frame",
      "type": "sticker_layer",
      "zIndex": 8,
      "start": 0,
      "end": 15,
      "asset": "overlays/postcard_frame.png",
      "blend": "normal"
    },
    {
      "id": "title_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 2,
      "end": 13,
      "text": "🌄 Carte Postale",
      "style": "cinema_subtitles",
      "animation": { "type": "fade", "duration": 0.8, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "cover"],

  "music": {
    "enabled": true,
    "beatSync": false,
    "defaultTrack": "traditional_soft"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#Paysage", "#Beauté", "#Afrique"]
  },

  "cardHint": {
    "inputSummary": "1 Photo",
    "timeLabel": "00:15"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 20
  }
}
