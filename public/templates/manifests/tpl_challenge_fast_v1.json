{
  "id": "tpl_challenge_fast_v1",
  "name": "Défi Viral Énergique",
  "description": "Template challenge avec hook, countdown, action et CTA duo",
  "version": "1.0.0",
  "duration": 30,
  "ratio": "9:16",
  "category": "challenge",
  "family": "grand_public",
  "tags": ["challenge", "beat", "duo", "viral"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo principale du défi",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 10,
        "maxDurationSec": 60
      }
    }
  ],

  "pipeline": [
    { "op": "smart_crop", "params": { "target": "person" }, "output": "cropRect", "weight": 0.10 },
    { "op": "beat_detect", "params": { "sensitivity": 0.7 }, "output": "beatMap", "weight": 0.15 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"] }, "output": "subtitleTrack", "weight": 0.25 },
    { "op": "style_transfer", "params": { "preset": "viral_pop" }, "output": "styledVideo", "weight": 0.20 },
    { "op": "denoise_sharpen", "params": { "level": 0.35 }, "output": "enhanced", "weight": 0.10 }
  ],

  "timeline": [
    {
      "id": "bg_layer",
      "type": "video_layer",
      "zIndex": 0,
      "start": 0,
      "end": 30,
      "asset": "scenes/challenge_bg.mp4",
      "blend": "normal"
    },
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 30,
      "slotRef": "video_main",
      "blend": "normal"
    },
    {
      "id": "hook_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0.3,
      "end": 3,
      "text": "{{texts.hook}}",
      "style": "bold_hook",
      "animation": { "type": "pop_in", "duration": 0.4, "easing": "ease-out" }
    },
    {
      "id": "countdown_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 4,
      "end": 10,
      "text": "{{texts.countdown}}",
      "style": "bold_hook",
      "animation": { "type": "bounce", "duration": 0.5, "easing": "ease-out" }
    },
    {
      "id": "result_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 20,
      "end": 25,
      "text": "{{texts.result}}",
      "style": "bold_hook",
      "animation": { "type": "slide", "duration": 0.4, "easing": "ease-out" }
    },
    {
      "id": "cta_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 25,
      "end": 30,
      "text": "{{texts.cta}}",
      "style": "bold_hook",
      "animation": { "type": "pulse", "duration": 0.6, "easing": "ease-in-out" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover", "stickers"],

  "music": {
    "enabled": true,
    "beatSync": true,
    "defaultTrack": "trending_energetic"
  },

  "publishDefaults": {
    "allowDuo": true,
    "hashtags": ["#TamTamChallenge", "#Défi", "#Viral"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:30"
  },

  "export": {
    "fps": 30,
    "preset": "fast",
    "crf": 23
  }
}
