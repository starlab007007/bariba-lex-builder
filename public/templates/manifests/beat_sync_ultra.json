{
  "id": "beat_sync_ultra",
  "name": "Beat-Sync Ultra",
  "description": "Montage auto sur le rythme de la musique",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "challenge",
  "family": "grand_public",
  "tags": ["beat", "music", "dance", "viral"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo principale",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 5,
        "maxDurationSec": 12
      }
    }
  ],

  "pipeline": [
    { "op": "smart_crop", "params": { "target": "person" }, "output": "cropRect", "weight": 0.10 },
    { "op": "beat_detect", "params": { "sensitivity": 0.8 }, "output": "beatMap", "weight": 0.20 },
    { "op": "style_transfer", "params": { "preset": "viral_pop" }, "output": "styledVideo", "weight": 0.15 },
    { "op": "auto_editing", "params": { "cuts": "beat_sync", "pacing": "fast" }, "output": "editPlan", "weight": 0.25 },
    { "op": "denoise_sharpen", "params": { "level": 0.4 }, "output": "enhanced", "weight": 0.10 }
  ],

  "timeline": [
    {
      "id": "bg_layer",
      "type": "video_layer",
      "zIndex": 0,
      "start": 0,
      "end": 15,
      "asset": "scenes/neon_bg.mp4",
      "blend": "normal"
    },
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 15,
      "slotRef": "video_main",
      "blend": "normal"
    },
    {
      "id": "beat_pulse_overlay",
      "type": "sticker_layer",
      "zIndex": 5,
      "start": 0,
      "end": 15,
      "asset": "overlays/beat_pulse.png",
      "animation": { "type": "pulse", "duration": 0.2, "easing": "ease-out" }
    },
    {
      "id": "title_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0.5,
      "end": 3,
      "text": "🎵 Beat-Sync",
      "style": "bold_hook",
      "animation": { "type": "pop_in", "duration": 0.3, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover", "stickers"],

  "music": {
    "enabled": true,
    "beatSync": true,
    "defaultTrack": "trending_energetic"
  },

  "publishDefaults": {
    "allowDuo": true,
    "hashtags": ["#BeatSync", "#Danse", "#Viral"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:15"
  },

  "export": {
    "fps": 30,
    "preset": "fast",
    "crf": 22
  }
}
