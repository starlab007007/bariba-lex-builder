{
  "id": "radio_village",
  "name": "Radio Village",
  "description": "Audio → vidéo animée avec waveform",
  "version": "1.0.0",
  "duration": 60,
  "ratio": "9:16",
  "category": "vocal",
  "family": "vocal_radio",
  "tags": ["radio", "audio", "waveform", "community"],
  "slots": [{ "id": "audio_main", "description": "Message vocal", "type": "audio", "required": true, "min": 1, "max": 1 }],
  "pipeline": [
    { "op": "audio_enhance", "params": { "denoise": true }, "output": "audioFx", "weight": 0.30 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"] }, "output": "subtitleTrack", "weight": 0.30 },
    { "op": "icon_injection", "params": { "mode": "contextual_emojis" }, "output": "iconLayer", "weight": 0.20 }
  ],
  "timeline": [
    { "id": "bg_layer", "type": "video_layer", "zIndex": 0, "start": 0, "end": 60, "asset": "scenes/radio_bg.mp4", "blend": "normal" },
    { "id": "waveform", "type": "sticker_layer", "zIndex": 3, "start": 0, "end": 60, "asset": "overlays/waveform.png", "blend": "add" }
  ],
  "overrides": ["text", "subtitles", "cover"],
  "music": { "enabled": false },
  "publishDefaults": { "allowDuo": false, "hashtags": ["#Radio", "#Village", "#Voix"] },
  "cardHint": { "inputSummary": "1 Audio", "timeLabel": "01:00" },
  "export": { "fps": 30, "preset": "medium", "crf": 21 }
}
