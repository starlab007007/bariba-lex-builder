{
  "id": "micro_cours_pratique",
  "name": "Micro-Cours",
  "description": "1 astuce en étapes claires",
  "version": "1.0.0",
  "duration": 45,
  "ratio": "9:16",
  "category": "storytelling",
  "family": "educatif_culture",
  "tags": ["tutorial", "learn", "tips", "education"],

  "slots": [
    {
      "id": "video_demo",
      "description": "Démonstration vidéo",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 20,
        "maxDurationSec": 90
      }
    }
  ],

  "pipeline": [
    { "op": "auto_editing", "params": { "cuts": "step_detection", "pacing": "educational" }, "output": "editPlan", "weight": 0.30 },
    { "op": "icon_injection", "params": { "mode": "step_numbers" }, "output": "iconLayer", "weight": 0.20 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"] }, "output": "subtitleTrack", "weight": 0.25 },
    { "op": "denoise_sharpen", "params": { "level": 0.35 }, "output": "enhanced", "weight": 0.15 }
  ],

  "timeline": [
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 45,
      "slotRef": "video_demo",
      "blend": "normal"
    },
    {
      "id": "step_indicators",
      "type": "sticker_layer",
      "zIndex": 5,
      "start": 0,
      "end": 45,
      "track": "iconLayer",
      "blend": "normal"
    },
    {
      "id": "title_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0.5,
      "end": 4,
      "text": "📚 Micro-Cours",
      "style": "bold_hook",
      "animation": { "type": "slide", "duration": 0.4, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover"],

  "music": {
    "enabled": false,
    "beatSync": false
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#Tuto", "#Apprendre", "#Astuce"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:45"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 21
  }
}
