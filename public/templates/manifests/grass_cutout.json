{
  "id": "grass_cutout",
  "name": "Détourage Prairie",
  "description": "Détourage personne sur fond prairie animé",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "transition",
  "family": "grand_public",
  "tags": ["cutout", "grass", "nature", "effect"],
  "slots": [{ "id": "video_main", "description": "Vidéo à détourer", "type": "video", "required": true, "min": 1, "max": 1, "constraints": { "minDurationSec": 3, "maxDurationSec": 15 } }],
  "pipeline": [
    { "op": "segmentation_person", "params": { "quality": "high" }, "output": "personMask", "weight": 0.40 },
    { "op": "stabilization", "params": { "strength": 0.5 }, "output": "stabilized", "weight": 0.25 }
  ],
  "timeline": [
    { "id": "grass_bg", "type": "video_layer", "zIndex": 0, "start": 0, "end": 15, "asset": "scenes/grass_animated.mp4", "blend": "normal" },
    { "id": "person_cutout", "type": "user_media_layer", "zIndex": 2, "start": 0, "end": 15, "slotRef": "video_main", "blend": "normal", "effects": ["segmentation"] }
  ],
  "overrides": ["music", "text", "cover", "stickers"],
  "music": { "enabled": true, "beatSync": false, "defaultTrack": "nature_ambient" },
  "publishDefaults": { "allowDuo": true, "hashtags": ["#Détourage", "#Prairie", "#Nature"] },
  "cardHint": { "inputSummary": "1 Video", "timeLabel": "00:15" },
  "export": { "fps": 30, "preset": "fast", "crf": 22 }
}
