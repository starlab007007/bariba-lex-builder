{
  "id": "metiers_terroir",
  "name": "Métiers du Terroir",
  "description": "Un jour, un métier - valorise le travail local",
  "version": "1.0.0",
  "duration": 45,
  "ratio": "9:16",
  "category": "storytelling",
  "family": "educatif_culture",
  "tags": ["work", "local", "terroir", "documentary"],

  "slots": [
    {
      "id": "video_main",
      "description": "Vidéo du métier",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 20,
        "maxDurationSec": 120
      }
    }
  ],

  "pipeline": [
    { "op": "auto_editing", "params": { "cuts": "contextual", "pacing": "documentary" }, "output": "editPlan", "weight": 0.25 },
    { "op": "icon_injection", "params": { "mode": "contextual_emojis" }, "output": "iconLayer", "weight": 0.20 },
    { "op": "asr_subtitles", "params": { "langs": ["fr", "ba"] }, "output": "subtitleTrack", "weight": 0.25 },
    { "op": "denoise_sharpen", "params": { "level": 0.3 }, "output": "enhanced", "weight": 0.15 }
  ],

  "timeline": [
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 45,
      "slotRef": "video_main",
      "blend": "normal"
    },
    {
      "id": "title_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 1,
      "end": 5,
      "text": "👨‍🌾 Métier du Jour",
      "style": "bold_hook",
      "animation": { "type": "slide", "duration": 0.5, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "subtitles", "cover"],

  "music": {
    "enabled": true,
    "beatSync": false,
    "defaultTrack": "traditional_soft"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#Métier", "#Terroir", "#Afrique"]
  },

  "cardHint": {
    "inputSummary": "1 Video",
    "timeLabel": "00:45"
  },

  "export": {
    "fps": 30,
    "preset": "medium",
    "crf": 20
  }
}
