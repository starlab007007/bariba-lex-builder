{
  "id": "voice_clone_hook",
  "name": "Voice Hook",
  "description": "Accroche avec ta propre voix clonée",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "vocal",
  "family": "grand_public",
  "tags": ["voice", "clone", "hook", "intro"],

  "slots": [
    {
      "id": "audio_voice",
      "description": "Échantillon de voix (5-10s)",
      "type": "audio",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 5,
        "maxDurationSec": 10
      }
    },
    {
      "id": "video_main",
      "description": "Vidéo principale",
      "type": "video",
      "required": true,
      "min": 1,
      "max": 1,
      "constraints": {
        "minDurationSec": 5,
        "maxDurationSec": 30
      }
    }
  ],

  "pipeline": [
    { "op": "voice_clone_hook", "params": { "seconds": 5, "style": "hook" }, "output": "voiceHook", "weight": 0.40 },
    { "op": "auto_editing", "params": { "cuts": "auto", "pacing": "punchy" }, "output": "editPlan", "weight": 0.25 },
    { "op": "audio_enhance", "params": { "denoise": true }, "output": "audioFx", "weight": 0.15 },
    { "op": "denoise_sharpen", "params": { "level": 0.35 }, "output": "enhanced", "weight": 0.10 }
  ],

  "timeline": [
    {
      "id": "main_video",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 15,
      "slotRef": "video_main",
      "blend": "normal"
    },
    {
      "id": "hook_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 0.5,
      "end": 4,
      "text": "🎤 Voice Hook",
      "style": "bold_hook",
      "animation": { "type": "pop_in", "duration": 0.3, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "cover"],

  "music": {
    "enabled": false,
    "beatSync": false
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#VoiceHook", "#Clone", "#Intro"]
  },

  "cardHint": {
    "inputSummary": "1 Audio + 1 Video",
    "timeLabel": "00:15"
  },

  "export": {
    "fps": 30,
    "preset": "fast",
    "crf": 22
  }
}
