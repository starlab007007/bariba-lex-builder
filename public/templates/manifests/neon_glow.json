{
  "id": "neon_glow",
  "name": "Néon Glow",
  "description": "Effet néon lumineux avec beat sync",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "challenge",
  "family": "grand_public",
  "tags": ["neon", "glow", "dance", "effect"],
  "slots": [{ "id": "video_main", "description": "Vidéo danse/mouvement", "type": "video", "required": true, "min": 1, "max": 1, "constraints": { "minDurationSec": 5, "maxDurationSec": 20 } }],
  "pipeline": [
    { "op": "beat_detect", "params": { "sensitivity": 0.8 }, "output": "beatMap", "weight": 0.25 },
    { "op": "style_transfer", "params": { "preset": "neon_glow" }, "output": "styledVideo", "weight": 0.45 }
  ],
  "timeline": [
    { "id": "neon_bg", "type": "video_layer", "zIndex": 0, "start": 0, "end": 15, "asset": "scenes/neon_city_bg.mp4", "blend": "normal" },
    { "id": "main_video", "type": "user_media_layer", "zIndex": 1, "start": 0, "end": 15, "slotRef": "video_main", "blend": "screen", "effects": ["neon_outline"] }
  ],
  "overrides": ["music", "text", "cover", "stickers"],
  "music": { "enabled": true, "beatSync": true, "defaultTrack": "electronic_beat" },
  "publishDefaults": { "allowDuo": true, "hashtags": ["#Neon", "#Glow", "#Danse"] },
  "cardHint": { "inputSummary": "1 Video", "timeLabel": "00:15" },
  "export": { "fps": 30, "preset": "fast", "crf": 22 }
}
