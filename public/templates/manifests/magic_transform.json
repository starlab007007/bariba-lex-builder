{
  "id": "magic_transform",
  "name": "Magic Transform",
  "description": "Transition avant/après spectaculaire",
  "version": "1.0.0",
  "duration": 15,
  "ratio": "9:16",
  "category": "transition",
  "family": "grand_public",
  "tags": ["before-after", "magic", "transition", "photo"],

  "slots": [
    {
      "id": "photo_before",
      "description": "Photo AVANT",
      "type": "photo",
      "required": true,
      "min": 1,
      "max": 1
    },
    {
      "id": "photo_after",
      "description": "Photo APRÈS",
      "type": "photo",
      "required": true,
      "min": 1,
      "max": 1
    }
  ],

  "pipeline": [
    { "op": "photo_animation", "params": { "mode": "kenburns+depth" }, "output": "animatedPhotos", "weight": 0.40 },
    { "op": "auto_editing", "params": { "transition": "magic_reveal" }, "output": "editPlan", "weight": 0.30 },
    { "op": "denoise_sharpen", "params": { "level": 0.3 }, "output": "enhanced", "weight": 0.15 }
  ],

  "timeline": [
    {
      "id": "bg_sparkle",
      "type": "video_layer",
      "zIndex": 0,
      "start": 0,
      "end": 15,
      "asset": "scenes/sparkle_bg.mp4",
      "blend": "normal"
    },
    {
      "id": "before_photo",
      "type": "user_media_layer",
      "zIndex": 1,
      "start": 0,
      "end": 7,
      "slotRef": "photo_before",
      "blend": "normal",
      "animation": { "type": "zoom", "duration": 7, "easing": "linear" }
    },
    {
      "id": "after_photo",
      "type": "user_media_layer",
      "zIndex": 2,
      "start": 7,
      "end": 15,
      "slotRef": "photo_after",
      "blend": "normal",
      "animation": { "type": "zoom", "duration": 8, "easing": "linear" }
    },
    {
      "id": "before_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 1,
      "end": 5,
      "text": "AVANT ⏮️",
      "style": "bold_hook",
      "animation": { "type": "pop_in", "duration": 0.3, "easing": "ease-out" }
    },
    {
      "id": "after_text",
      "type": "text_layer",
      "zIndex": 10,
      "start": 9,
      "end": 14,
      "text": "✨ APRÈS",
      "style": "bold_hook",
      "animation": { "type": "pop_in", "duration": 0.3, "easing": "ease-out" }
    }
  ],

  "overrides": ["music", "text", "cover", "stickers"],

  "music": {
    "enabled": true,
    "beatSync": true,
    "defaultTrack": "magic_reveal"
  },

  "publishDefaults": {
    "allowDuo": false,
    "hashtags": ["#AvantAprès", "#Magic", "#Transform"]
  },

  "cardHint": {
    "inputSummary": "2 Photos",
    "timeLabel": "00:15"
  },

  "export": {
    "fps": 30,
    "preset": "fast",
    "crf": 22
  }
}
